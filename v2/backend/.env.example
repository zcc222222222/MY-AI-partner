# DeepSeek API 密钥(必填)。
# 留占位值等于没配:后端启动时会直接拒绝启动并说明原因(fail fast)。
# 真实密钥建议只写在 backend/.env —— 它已被 .gitignore 忽略,不会进仓库。
DEEPSEEK_API_KEY=sk-你的密钥

# DeepSeek 接口地址(一般不用改)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名:本项目使用 deepseek-flash(已实测 function calling 可用)。
# 不要用 deepseek-chat / deepseek-reasoner —— 它们是遗留兼容别名,官方已排期下线。
# 换机器或部署时请显式写模型名,不要依赖默认值。
DEEPSEEK_MODEL=deepseek-flash

# 生成参数。角色扮演建议 0.8~1.0;未来攻略问答走 0.2~0.3(意图分流见 v2)。
LLM_TEMPERATURE=0.9
# 包含模型推理预算；工具收口预算可提升至8192，空回答耗尽时最多重试一次至8192。
LLM_MAX_TOKENS=4096
# 思考模式下温度不生效；当前测试保留high，low出现过空正文。
LLM_REASONING_EFFORT=high
LLM_FINAL_MAX_TOKENS=8192
LLM_RETRY_MAX_TOKENS=8192
# 聊天编排累计输出预算，包含推理和自动重试；不含输入token。标题另限128、关闭思考。
LLM_TURN_MAX_TOKENS=24576

# 会话输入使用UTF-8字节保守估算，非精确计费token；原始消息完整保留。
# 本地安全窗口，不代表模型服务的最大窗口。每次调用另留回答与协议空间。
LLM_CONTEXT_WINDOW_TOKENS=65536
LLM_HISTORY_BUDGET=16000
LLM_SUMMARY_BUDGET=4000
LLM_SUMMARY_INPUT_BUDGET=16000

# 本地用 SQLite 即可;上线换 MySQL 时改成 mysql+pymysql://user:pass@host:3306/db
DATABASE_URL=sqlite:///./data/app.db

# Optional Wiki upstream DB relocation; Compose sets this to /app/data/knowledge.db.
# Leave unset locally to use the original subscribed source paths.
# WIKI_UPSTREAM_DB_PATH=/absolute/path/to/knowledge.db

# 登录 Cookie：本地 HTTP 使用 false；部署 HTTPS 时必须改为 true。
AUTH_COOKIE_NAME=aipartner_session
AUTH_COOKIE_SECURE=false
# 登录有效期（小时），退出立即撤销当前登录。
AUTH_SESSION_HOURS=168
# 每个客户端 IP 每五分钟允许的注册/登录总次数。
AUTH_RATE_LIMIT=30

# 知识库管理员：填现有账号的固定用户 ID，逗号分隔；留空关闭管理入口。
# 修改后重启后端。不要填用户名，也不要开放给普通注册账号。
KNOWLEDGE_ADMIN_USER_IDS=

# 可选：工具运行摘要的独立目录（默认 data/retrieval-diagnostics）。不保存玩家问题正文。
# RETRIEVAL_DIAGNOSTICS_DIR=

# QQ 邮箱 SMTP：在 QQ 邮箱安全设置中开启服务，密码填 SMTP 授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# 随机密钥（至少32字符），用于验证码 HMAC；所有后端实例须保持一致。
# 可运行：python -c "import secrets; print(secrets.token_hex(32))"
EMAIL_CODE_SECRET=
# MySQL 示例（密码特殊字符需 URL 编码；库预先创建为 utf8mb4）：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/aipartner?charset=utf8mb4

# 允许跨域的前端地址(逗号分隔)。Vite 代理模式下通常用不到。
CORS_ORIGINS=http://localhost:5173

# 日志级别。INFO 才能看到每轮的 token 用量与缓存命中。
LOG_LEVEL=INFO

# 小范围演示额度；金额单位为微元，1,000,000微元 = 1元人民币。
# 同时受次数和费用限制；每日/月度按北京时间划分，无需定时清零。
QUOTA_USER_DAILY_QUESTIONS=20
QUOTA_GLOBAL_DAILY_QUESTIONS=200
QUOTA_USER_DAILY_MICROS=500000
QUOTA_GLOBAL_DAILY_MICROS=5000000
QUOTA_GLOBAL_MONTHLY_MICROS=50000000
QUOTA_USER_RPM=3
QUOTA_USER_CONCURRENCY=1
QUOTA_GLOBAL_CONCURRENCY=3
GENERATION_TIMEOUT_SECONDS=300
