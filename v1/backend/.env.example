# DeepSeek API 密钥(必填)
DEEPSEEK_API_KEY=sk-你的密钥

# DeepSeek 接口地址(一般不用改)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名:按你账号实际可用模型填写。
# 旧代码用的是 deepseek-v4-pro;官方文档常用 deepseek-chat / deepseek-reasoner。
DEEPSEEK_MODEL=deepseek-chat

# 本地用 SQLite 即可;上线换 MySQL 时改成 mysql+pymysql://user:pass@host:3306/db
DATABASE_URL=sqlite:///./data/app.db

# 允许跨域的前端地址(逗号分隔)。Vite 代理模式下通常用不到。
CORS_ORIGINS=http://localhost:5173
